NODE_ENV=development
PORT=4000

# Local: run `npm run db:dev` (Prisma's built-in Postgres, no Docker needed) and use its direct TCP URL.
# Production: the managed Postgres connection string from Railway/Render.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Scratch database Prisma uses to check migrations (prisma dev runs it on the next port).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# prisma dev only handles one connection reliably; remove (or raise) for a real Postgres.
DATABASE_POOL_MAX=1

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of browser origins allowed to call the API (coach dashboard).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Deep link used in password reset emails.
APP_RESET_PASSWORD_URL=fitnessapp://reset-password

# Public base URL of this API (Mayar redirects customers here after paying).
PUBLIC_API_URL=http://localhost:4000
APP_PAYMENT_RETURN_URL=fitnessapp://payment-complete

# Encrypts personal data at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Mayar (https://docs.mayar.id). Sandbox: https://api.mayar.io/hl/v1  Production: https://api.mayar.id/hl/v1
MAYAR_BASE_URL=https://api.mayar.io/hl/v1
MAYAR_API_KEY=
# Register the webhook in Mayar as: <PUBLIC_API_URL>/api/payments/mayar-callback?token=<MAYAR_WEBHOOK_TOKEN>
MAYAR_WEBHOOK_TOKEN=

# Requests per minute per IP (spec: 100 in production). Higher locally: app + dashboard share localhost.
API_RATE_LIMIT_PER_MIN=1000

PRICE_MONTHLY_IDR=79000
PRICE_COACHING_IDR=499000
